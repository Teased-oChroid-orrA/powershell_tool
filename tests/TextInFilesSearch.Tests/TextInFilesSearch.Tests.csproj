<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately a plain console app, not an xUnit/MSTest project - this
    keeps the entire test suite dependency-free (no test-framework NuGet
    package needed), so it was possible to develop and fully verify every
    one of these 36 checks locally without any internet access, including
    the exact PDF ASCII85+FlateDecode case and the single-element-array
    edge cases that caused real, subtle bugs during development.

    Run with: dotnet run (from this folder), or dotnet run with the project
    path passed via the standard dotnet CLI project switch.
    Exit code 0 = all checks passed, 1 = at least one failed (see build.yml).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TextInFilesSearch.Core/TextInFilesSearch.Core.csproj" />
  </ItemGroup>

  <!--
    Real DOCX/PPTX/PDF fixtures used by the "real formats" check below.
    Embedded (rather than referenced by a hardcoded filesystem path) so the
    test harness runs identically on any machine/CI runner with no setup
    step required.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/test.docx">
      <LogicalName>test.docx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures/test.pptx">
      <LogicalName>test.pptx</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Fixtures/test.pdf">
      <LogicalName>test.pdf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
