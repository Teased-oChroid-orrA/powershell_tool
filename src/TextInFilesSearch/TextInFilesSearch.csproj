<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TextInFilesSearch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!--
      ================================================================
      SELF-CONTAINED, UNPACKAGED DEPLOYMENT (see docs/deployment.md)
      ================================================================
      Goal: the published output must run on a clean Windows machine with
      no internet access, no admin rights, no pre-installed .NET runtime,
      and no pre-installed Windows App SDK runtime.
    -->

    <!-- Bundle the .NET runtime itself into the publish output. -->
    <SelfContained>true</SelfContained>

    <!--
      Bundle the Windows App SDK runtime components (the WinUI 3 native
      libraries) into the publish output too, instead of requiring the
      Windows App SDK runtime to be installed machine-wide. This is the
      single most important setting for the "no pre-installed dependency"
      requirement - see docs/deployment.md for what this actually produces
      on disk and how it was verified.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!--
      Unpackaged deployment: no MSIX, no installer, no admin-requiring
      registration step. The published folder can be copied to a target
      machine and run directly - this is the "prefer unpackaged" guidance
      from the migration brief. WindowsPackageType=None is what actually
      controls this - independently verified every CI run by the "Verify
      no MSIX / packaged-app artifacts were produced" step in build.yml.
    -->
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      Real field bug (docs/deployment.md's "First real-machine launch"
      section): this was EnableMsixTooling=false, on the reasonable-looking
      assumption that "unpackaged, so disable the packaging tooling." That
      setting does not only control MSIX packaging, though - it gates the
      *entire* packaging-tooling MSBuild target chain, which PRI (resource
      index) generation rides along with even though it has nothing to do
      with MSIX. With it false, the publish output shipped with zero
      resources.pri file, so every ms-appx:///... XAML page URI
      (Application.LoadComponent for MainWindow.xaml, in this app's case)
      failed at runtime with "Cannot locate resource from
      'ms-appx:///Views/MainWindow.xaml'" (HResult 0x802B000A) - the app
      launched and then silently produced no window at all, confirmed by a
      real crash.log from an actual Windows machine, not assumed. Setting
      this true does not reintroduce MSIX output - WindowsPackageType=None
      above is the actual, separately-verified control for that.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      Reliability over a single EXE: a folder-based publish is the default
      here. PublishSingleFile is deliberately left OFF because WinUI 3's
      native resources and the Windows App SDK's own bundled DLLs have a
      documented history of single-file-publish edge cases; a working
      folder-based deployment beats a fragile single EXE. If single-file is
      wanted later, verify it explicitly against a clean machine before
      relying on it - do not assume it works from a green build alone.
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContainedDeployment>true</SelfContainedDeployment>

    <!--
      Trimming is left off. IL trimming has real, documented risk of removing
      code that's only reached via reflection (which WinUI/XAML uses
      internally) unless every trimming warning is individually resolved and
      the trimmed output is tested on a clean machine. Given the migration
      brief prioritizes reliability over minimizing file size, trimming is
      not enabled without that verification step having actually happened.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- No auto-update / telemetry / network calls of any kind. -->
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240311000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.2428" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TextInFilesSearch.Core/TextInFilesSearch.Core.csproj" />
  </ItemGroup>

  <!--
    Brand assets (GS Engineering). AppIcon.ico is also referenced by
    ApplicationIcon above (baked into the exe's Win32 resources at compile
    time), but is listed again here too so the physical file itself is
    copied to the output/publish folder - MainWindow.xaml.cs loads it from
    disk at runtime via AppWindow.SetIcon() for the window/taskbar icon,
    which ApplicationIcon alone does not set for a WinUI 3 app.
  -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Banner.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    native_search.dll (issue #2 - see docs/ffi.md). Included only when the
    Rust crate has already been built, so a plain `dotnet build`/`publish`
    of this project alone - on a machine without the Rust toolchain -
    doesn't fail for lack of it. CI builds native-search/ before this
    project for exactly that reason (.github/workflows/build.yml); this
    Content item is what makes that copy happen through the normal MSBuild
    publish pipeline instead of a separate CI shell step now that the two
    would otherwise duplicate each other.
  -->
  <ItemGroup Condition="Exists('..\..\native-search\target\x86_64-pc-windows-msvc\release\native_search.dll')">
    <Content Include="..\..\native-search\target\x86_64-pc-windows-msvc\release\native_search.dll">
      <Link>native_search.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
