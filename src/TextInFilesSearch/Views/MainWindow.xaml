<Window
    x:Class="TextInFilesSearch.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextInFilesSearch.Views"
    xmlns:vm="using:TextInFilesSearch.ViewModels"
    xmlns:models="using:TextInFilesSearch.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar / brand banner (GS Engineering) -->
        <Grid x:Name="AppTitleBar" Height="64" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Image Source="Assets/Banner.png"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Height="48"
                   Margin="16,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ Settings panel ============================ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">

                    <TextBlock Text="Required" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Search folder" Width="280"
                                 Text="{x:Bind ViewModel.SearchPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Browse..." VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseSearchFolderCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Header="Output folder" Width="280"
                                 Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Browse..." VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseOutputFolderCommand}" />
                    </StackPanel>

                    <TextBox Header="Filters (comma-separated)"
                             PlaceholderText="e.g. invoice, overdue"
                             Text="{x:Bind ViewModel.FiltersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Expander Header="Matching" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Spacing="10" Padding="0,8,0,0">
                            <ComboBox Header="Match mode" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind MatchModeOptions}"
                                      SelectedItem="{x:Bind ViewModel.MatchMode, Mode=TwoWay}" />
                            <NumberBox Header="Proximity lines" Minimum="0" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.ProximityLines, Mode=TwoWay}" />
                            <ToggleSwitch Header="Use regex" IsOn="{x:Bind ViewModel.UseRegex, Mode=TwoWay}" />
                            <ToggleSwitch Header="Whole word matching" IsOn="{x:Bind ViewModel.WholeWord, Mode=TwoWay}" />
                            <TextBox Header="Exclude filters (comma-separated)"
                                     Text="{x:Bind ViewModel.ExcludeFiltersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Header="Exclude scope" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind ExcludeScopeOptions}"
                                      SelectedItem="{x:Bind ViewModel.ExcludeScope, Mode=TwoWay}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Scope and output" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Spacing="10" Padding="0,8,0,0">
                            <!--
                                Extension type-to-filter + tick-list: typing
                                narrows the catalog below to matching
                                extensions/categories; ticking one or more
                                selects them. Ticking nothing behaves exactly
                                like the old blank-means-default free-text
                                box did. A typed extension not already in the
                                catalog can be added as a one-off custom pick.
                            -->
                            <StackPanel Spacing="6">
                                <TextBox Header="File extensions - type to filter, tick to select"
                                         PlaceholderText="e.g. doc, py, log..."
                                         Text="{x:Bind ViewModel.ExtensionFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ListView ItemsSource="{x:Bind ViewModel.FilteredExtensionCatalog}"
                                          MaxHeight="220"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExtensionOption">
                                            <CheckBox Content="{x:Bind Display}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Add as custom extension" Command="{x:Bind ViewModel.AddCustomExtensionCommand}" />
                                    <Button Content="Clear selection" Command="{x:Bind ViewModel.ClearSelectedExtensionsCommand}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SelectedExtensionsSummaryText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" Opacity="0.85" />
                            </StackPanel>
                            <TextBox Header="Exclude folders (comma-separated)"
                                     Text="{x:Bind ViewModel.ExcludeFoldersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleSwitch Header="Include hidden files" IsOn="{x:Bind ViewModel.IncludeHidden, Mode=TwoWay}" />
                            <NumberBox Header="Max file size (MB)" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.MaxFileSizeMB, Mode=TwoWay}" />
                            <ComboBox Header="Group by" HorizontalAlignment="Stretch"
                                      ItemsSource="{x:Bind GroupByOptions}"
                                      SelectedItem="{x:Bind ViewModel.GroupBy, Mode=TwoWay}" />
                            <ToggleSwitch Header="Open report when done" IsOn="{x:Bind ViewModel.OpenReportWhenDone, Mode=TwoWay}" />
                            <ToggleSwitch Header="Export CSV" IsOn="{x:Bind ViewModel.ExportCsv, Mode=TwoWay}" />
                            <ToggleSwitch Header="Export JSON" IsOn="{x:Bind ViewModel.ExportJson, Mode=TwoWay}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Performance and robustness" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Spacing="10" Padding="0,8,0,0">
                            <ToggleSwitch Header="Parallel processing" IsOn="{x:Bind ViewModel.Parallel, Mode=TwoWay}" />
                            <NumberBox Header="Parallel throttle limit" Minimum="1" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.ThrottleLimit, Mode=TwoWay}" />
                            <TextBox Header="Cache file (blank = disabled)"
                                     Text="{x:Bind ViewModel.CacheFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleSwitch Header="Dry run (list files only)" IsOn="{x:Bind ViewModel.DryRun, Mode=TwoWay}" />
                            <NumberBox Header="PDF extraction timeout (seconds)" Minimum="1" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.PdfTimeoutSeconds, Mode=TwoWay}" />
                            <NumberBox Header="Per-file read timeout (seconds)" Minimum="1" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.FileTimeoutSeconds, Mode=TwoWay}" />
                            <NumberBox Header="Max retries (locked files)" Minimum="0" SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.MaxRetries, Mode=TwoWay}" />
                        </StackPanel>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Run Search" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RunSearchCommand}" />
                        <Button Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                        <Button Content="Open Report" Command="{x:Bind ViewModel.OpenReportCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ Progress + results panel ============================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>

                <!--
                    Live in-flight file activity - this is the direct answer to
                    "a slow PDF looks hung with no insight into what's happening".
                    Each row shows the file name, elapsed seconds, and a status
                    string that updates as extraction progresses (e.g. "342
                    streams scanned") instead of the UI going silent.
                    Bound directly to Models.InFlightFileStatus - no extra
                    view-only helper type, to keep the binding surface minimal.
                -->
                <ListView Grid.Row="1" Margin="0,12,0,0"
                          ItemsSource="{x:Bind ViewModel.InFlightFiles}"
                          MaxHeight="180"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:InFlightFileStatus">
                            <Grid Padding="4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind ElapsedSeconds}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2" Margin="0,12,0,8"
                           Text="{x:Bind ViewModel.ResultsSummaryText, Mode=OneWay}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />

                <ListView Grid.Row="3"
                          ItemsSource="{x:Bind ViewModel.Results}"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileResultViewModel">
                            <Grid Padding="8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind FullName}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind HitCount}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
